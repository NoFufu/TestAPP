{
  "expo": {
    "name": "fitspot",
    "slug": "nofufu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nofufu.fitspot"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nofufu.fitspot"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "fitspot braucht Zugriff auf deine Fotos, damit du Spots hochladen kannst.",
          "cameraPermission": "fitspot braucht die Kamera, damit du Spots direkt fotografieren kannst.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "fitspot zeigt dir Foto-Spots in deiner N\u00e4he."
        }
      ]
    ],
    "scheme": "fitspot",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e9eb2025-8e60-432a-ae89-13a9a89b6c06"
      }
    },
    "owner": "nofufu1234s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e9eb2025-8e60-432a-ae89-13a9a89b6c06"
    }
  }
}
