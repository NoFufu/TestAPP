{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "testflight": {
      "distribution": "store",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  }
}
